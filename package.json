{
  "name": "patna-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @patna/web dev",
    "build": "pnpm --filter @patna/web build",
    "start": "pnpm --filter @patna/web start",
    "lint": "pnpm --filter @patna/web lint",
    "applications:import": "pnpm --filter @patna/web exec node ./scripts/import-community-applications.mjs",
    "cohorts:import": "pnpm --filter @patna/web exec node ./scripts/import-cohort-members.mjs",
    "events:import": "pnpm --filter @patna/web exec node ./scripts/import-events-register.mjs",
    "headshots:migrate": "pnpm --filter @patna/web exec node ./scripts/migrate-headshots-to-storage.mjs",
    "resumes:migrate": "pnpm --filter @patna/web exec node ./scripts/migrate-resumes-to-storage.mjs",
    "supabase:link": "./scripts/supabase-link.sh",
    "supabase:push": "./scripts/supabase-push.sh",
    "supabase:types": "./scripts/supabase-types.sh"
  }
}
